<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>VMonitorSetup</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- UAC: 管理者権限を要求する -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Resources\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!--
      driver\** は同梱しない。

      Program.cs は「exe の隣に driver フォルダがあればそちらを優先」する。
      ここで拾うようにしていたため、ソース中に置き忘れた古い一式が
      ビルドのたびに出力へ運ばれ、それが入ってしまう余地があった。
      実際 7 月 7 日のドライバが 1 か月以上残っていた。

      配布時のドライバは Inno Setup が driver\dist から {app}\driver へ置く。
      開発中に単体で使いたい場合は、exe の隣に自分で置けば今も拾われる。
    -->
    <None Remove="driver\**" />
  </ItemGroup>

</Project>
