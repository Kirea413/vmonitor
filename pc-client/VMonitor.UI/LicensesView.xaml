<UserControl x:Class="VMonitor.UI.LicensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="オープンソース ライセンス"
                       FontSize="22" FontWeight="SemiBold" Foreground="#111827"/>
            <TextBlock Text="vmonitor は、次のソフトウェアを利用して作られています。各プロジェクトの皆様に感謝します。"
                       Margin="0,5,0,0" Foreground="#6B7280" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB"
                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <ItemsControl ItemsSource="{Binding Components, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB"
                                BorderThickness="1" CornerRadius="6" Padding="10,7"
                                Margin="0,0,8,8" MinWidth="190">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding License}" FontSize="11" Foreground="#6B7280"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB"
                BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="著作権表示・配布条件・対応ソース"
                           FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBox Grid.Row="1" Text="{Binding NoticeText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         BorderThickness="0" Background="Transparent" FontFamily="Consolas"
                         FontSize="12" Foreground="#374151"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
