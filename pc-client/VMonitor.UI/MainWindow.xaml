<Window x:Class="VMonitor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VMonitor.UI.ViewModels"
        mc:Ignorable="d"
        Title="vmonitor" Height="720" Width="1060"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Window.Resources>
        <!-- ステータス文字列 → 背景色 変換リソース（インライン Style で代替） -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ボタン・カード・入力欄・状態ドットは Theme.xaml に集約した。
             ここに書いていた頃は、同じ役割のものが画面ごとに違う形をしていた。 -->

        <!-- 接続候補リストのアイテムスタイル -->
        <Style x:Key="CandidateItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <!-- 接続パネルの丸印。Theme の StatusDot に、接続で緑になる規則を足す。 -->
        <Style x:Key="StatusDotStyle" TargetType="Ellipse"
               BasedOn="{StaticResource StatusDot}">
            <Setter Property="Margin" Value="0,0,9,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource Good}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <!-- タイトルバー -->
            <RowDefinition Height="48"/>
            <!-- 通知バナー（タイムアウト / 切断） -->
            <RowDefinition Height="Auto"/>
            <!-- メインコンテンツ -->
            <RowDefinition Height="*"/>
            <!-- ステータスバー -->
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- ━━━ タイトルバー ━━━ -->
        <Border Grid.Row="0" Background="#1E3A5F">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 自分の名前を大書きしても利用者には何も伝わらない。
                     小さく置いて、隣にいまの状態を出す。 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="vmonitor" Foreground="#B9C6D8"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <Border Width="1" Height="16" Background="#3A567C"
                            Margin="12,0" VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding ConnectionStatus}" Foreground="White"
                               FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 接続ステータスインジケーター -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,4,0">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10"
                             VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#9CA3AF"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConnectionStatus}" Value="接続済み">
                                        <Setter Property="Fill" Value="#22C55E"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionStatus}" Value="接続中...">
                                        <Setter Property="Fill" Value="#FACC15"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionStatus}" Value="再接続中...">
                                        <Setter Property="Fill" Value="#FACC15"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionStatus}" Value="切断">
                                        <Setter Property="Fill" Value="#EF4444"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <!-- 状態の文言は左に移した。ここは丸印だけにする。
                         同じ言葉を並べても情報は増えない。 -->
                </StackPanel>
            </Grid>
        </Border>

        <!-- ━━━ 通知バナー（タイムアウト: Requirements 2.4） ━━━ -->
        <Border Grid.Row="1" Background="#FEF3C7" BorderBrush="#F59E0B"
                BorderThickness="0,0,0,2"
                Visibility="{Binding ShowTimeoutNotification, Converter={StaticResource BoolToVis}}">
            <Grid Margin="16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⏱" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding NotificationMessage}" FontSize="13"
                               Foreground="#92400E" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>

                <Button Grid.Column="1" Content="再試行" Margin="8,0"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding RetryConnectCommand}"/>
                <Button Grid.Column="2" Content="閉じる" Margin="0,0,4,0"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding DismissNotificationCommand}"/>
            </Grid>
        </Border>

        <!-- ━━━ 通知バナー（切断通知: Requirements 2.6） ━━━ -->
        <Border Grid.Row="1" Background="#FEE2E2" BorderBrush="#EF4444"
                BorderThickness="0,0,0,2"
                Visibility="{Binding ShowDisconnectNotification, Converter={StaticResource BoolToVis}}">
            <Grid Margin="16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconWarning}"
                          Stroke="{StaticResource Warn}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding NotificationMessage}" FontSize="13"
                               Foreground="#991B1B" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>

                <Button Grid.Column="1" Content="再接続" Margin="8,0"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding ReconnectCommand}"/>
                <Button Grid.Column="2" Content="閉じる" Margin="0,0,4,0"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding DismissNotificationCommand}"/>
            </Grid>
        </Border>

        <!-- ━━━ メインコンテンツ ━━━ -->
        <TabControl Grid.Row="2" Margin="16,12,16,0" Style="{StaticResource TabStrip}">

            <!-- 接続タブ -->
            <TabItem Style="{StaticResource Tab}" Header="接続">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <!-- 右ペインを畳んだぶん、一覧に幅を渡す -->
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- ── USB 直結の操作 ──
                 USB では PC 側が端末を掴みにいくので、繋ぐ・切るは
                 PC からも操作できる必要がある。 -->
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                    Style="{StaticResource Card}"
                    DataContext="{Binding Usb}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 繋がっているかどうかを、文言を読まなくても分かるようにする -->
                    <Ellipse Grid.Row="0" Grid.Column="0"
                             Style="{StaticResource StatusDotStyle}"/>

                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="USB 直結" FontWeight="SemiBold" FontSize="14"
                                   VerticalAlignment="Center"/>

                        <!-- 「ケーブルが挿さっている」と「映像が流れている」を
                             取り違えないよう、段階を明示する。
                             ただし「未接続」のときは出さない。ヘッダーが
                             同じことを言っており、繰り返しても情報は増えない。 -->
                        <Border Background="#F3F4F6" CornerRadius="9"
                                Padding="7,1" Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StageLabel}" Value="未接続">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StageLabel}" FontSize="11"
                                       Foreground="#4B5563"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Status}"
                               Foreground="#6B7280" VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="420"/>

                    <Button Grid.Row="0" Grid.Column="3" Content="接続"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ConnectCommand}"/>

                    <Button Grid.Row="0" Grid.Column="4" Content="切断"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding DisconnectCommand}"/>

                    <!-- TextTrimming だけでは幅は縮まない。折り返しを許して、
                         この行がウィンドウを押し広げないようにする。 -->
                    <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3"
                               Text="ケーブルで繋ぐといちばん遅延が少なくなります。"
                               Foreground="#9CA3AF" FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </Grid>
            </Border>

            <!-- ── Wi-Fi でスマホへ繋ぎにいく ──
                 スマホのホーム画面に出ているアドレスとポートを入れる。
                 PC の前にいるとき、スマホを手に取らずに始められるようにするため。 -->
            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                    Style="{StaticResource Card}"
                    DataContext="{Binding Device}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Row="0" Grid.Column="0"
                             Style="{StaticResource StatusDotStyle}"/>

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Wi-Fi でスマホへ"
                               FontWeight="SemiBold" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <!-- アドレスとポートは横並び。スマホの画面に
                         「192.168.1.19 : 7980」の形で出ているものを写す。 -->
                    <Grid Grid.Row="0" Grid.Column="2" Margin="0,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Style="{StaticResource AddressField}"
                                 Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="スマホの画面に出ているアドレス"
                                 Margin="0,0,6,0"
                                 ToolTip="スマホのホーム画面に出ている IP アドレス"/>

                        <!-- 数字だけ置くと何の値か分からない。単位を添える。 -->
                        <TextBlock Grid.Column="1" Text="ポート"
                                   Foreground="{StaticResource Muted}" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>

                        <TextBox Grid.Column="2" Width="72"
                                 Style="{StaticResource NumberField}"
                                 Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="スマホが待ち受けているポート"/>
                    </Grid>

                    <Button Grid.Row="0" Grid.Column="3" Content="接続"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ConnectCommand}"/>

                    <Button Grid.Row="0" Grid.Column="4" Content="切断"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding DisconnectCommand}"/>

                    <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3"
                               Text="{Binding Status}"
                               Foreground="#6B7280" FontSize="11"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <!-- ── 左ペイン: 接続候補リスト ── -->
            <Border Grid.Row="2" Grid.Column="0" Background="White" CornerRadius="6"
                    BorderBrush="#E5E7EB" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- リストヘッダー -->
                    <Border Grid.Row="0" Background="#F9FAFB"
                            BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"
                            CornerRadius="6,6,0,0" Padding="12,8">
                        <TextBlock Text="接続候補デバイス" FontWeight="SemiBold"
                                   FontSize="13" Foreground="#374151"/>
                    </Border>

                    <!-- 候補リスト -->
                    <ListView Grid.Row="1"
                              x:Name="CandidateList"
                              ItemsSource="{Binding Candidates}"
                              SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}"
                              BorderThickness="0"
                              ItemContainerStyle="{StaticResource CandidateItemStyle}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- デバイスアイコン -->
                                    <Path Grid.Column="0" Style="{StaticResource IconAccent}"
                                          Data="{StaticResource IconPhone}"
                                          Width="22" Height="22" Margin="0,0,10,0"/>

                                    <!-- デバイス情報 -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   FontSize="13" Foreground="#111827"/>
                                        <TextBlock FontSize="11" Foreground="#6B7280" Margin="0,1,0,0">
                                            <Run Text="{Binding Platform, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Resolution, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding TransportIcon}" FontSize="11"
                                                   Foreground="#6B7280" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>

                        <!-- 候補が空の場合のプレースホルダー -->
                        <ListView.Style>
                            <Style TargetType="ListView">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Candidates.Count}" Value="0">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <!--
                                                    繋がっていないあいだ、いちばん広いこの場所が
                                                    「探索中」の一行だけだった。ここで
                                                    「何がどう繋がるのか」と「次に何をすればよいか」
                                                    の両方を示す。
                                                -->
                                                <ControlTemplate>
                                                    <StackPanel VerticalAlignment="Center"
                                                                HorizontalAlignment="Center"
                                                                Margin="24">

                                                        <!-- PC ── ケーブル ── スマホ。
                                                             文字で説明するより早い。 -->
                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Center"
                                                                    Margin="0,0,0,22">
                                                            <Path Data="{StaticResource IconMonitor}"
                                                                  Style="{StaticResource Icon}"
                                                                  Stroke="{StaticResource Faint}"
                                                                  Width="52" Height="52"
                                                                  StrokeThickness="1.3"/>

                                                            <!-- 繋がっていないので破線 -->
                                                            <Path Data="M0,0 H56"
                                                                  Stroke="{StaticResource Idle}"
                                                                  StrokeThickness="2"
                                                                  StrokeDashArray="3 3"
                                                                  StrokeDashCap="Round"
                                                                  VerticalAlignment="Center"
                                                                  Margin="14,0"/>

                                                            <Path Data="{StaticResource IconPhone}"
                                                                  Style="{StaticResource Icon}"
                                                                  Stroke="{StaticResource Faint}"
                                                                  Width="52" Height="52"
                                                                  StrokeThickness="1.3"/>
                                                        </StackPanel>

                                                        <TextBlock Text="スマホを繋ぐと、2 枚目の画面になります"
                                                                   FontSize="15" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Body}"
                                                                   HorizontalAlignment="Center"/>

                                                        <TextBlock Text="ケーブルで繋ぐか、同じ Wi-Fi につないでください。"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource Muted}"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,8,0,0"/>

                                                        <!-- 次の一手。上のパネルと同じ操作だが、
                                                             探している人の目はここに来る。 -->
                                                        <TextBlock Text="どちらかで「接続」を押すと、スマホ側に確認が出ます。"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource Faint}"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.Style>
                    </ListView>
                </Grid>
            </Border>

            <!-- ── 右ペイン: 接続管理 ──
                 畳んである。上の USB / Wi-Fi パネルと機能が丸ごと重複しており、
                 「接続」に相当するボタンが画面に 4 つ、「未接続」の表示が
                 5 箇所ある状態になっていた。どれを押すのが正解か分からない。

                 操作は上のパネルに一本化した。ここは選択中のデバイスを
                 一覧から操作する用途で作られたものだが、実際には
                 一覧から選んで繋ぐ導線は使われていない。 -->
            <Border Grid.Row="2" Grid.Column="2" Background="White" CornerRadius="6"
                    BorderBrush="#E5E7EB" BorderThickness="1"
                    Visibility="Collapsed">
                <StackPanel Margin="16,12">

                    <!-- セクションタイトル -->
                    <TextBlock Text="接続管理" FontWeight="SemiBold"
                               FontSize="14" Foreground="#111827" Margin="0,0,0,12"/>

                    <!-- 選択デバイス表示 -->
                    <Border Background="#F9FAFB" CornerRadius="4"
                            BorderBrush="#E5E7EB" BorderThickness="1"
                            Padding="10,8" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="選択中のデバイス" FontSize="11"
                                       Foreground="#6B7280" Margin="0,0,0,2"/>
                            <TextBlock FontSize="13" Foreground="#374151">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="（未選択）"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedCandidate}" Value="{x:Null}">
                                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- 選択中デバイス名 -->
                            <TextBlock Text="{Binding SelectedCandidate.Name}"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#111827"
                                       Visibility="{Binding SelectedCandidate,
                                           Converter={StaticResource BoolToVis},
                                           TargetNullValue=Collapsed,
                                           FallbackValue=Collapsed}"/>
                            <TextBlock FontSize="11" Foreground="#6B7280" Margin="0,1,0,0"
                                       Visibility="{Binding SelectedCandidate,
                                           Converter={StaticResource BoolToVis},
                                           TargetNullValue=Collapsed,
                                           FallbackValue=Collapsed}">
                                <Run Text="{Binding SelectedCandidate.Platform, Mode=OneWay}"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding SelectedCandidate.TransportIcon, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 接続状態 -->
                    <TextBlock Text="接続状態" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4"/>
                    <Border CornerRadius="4" Padding="8,6" Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#F3F4F6"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConnectionStatus}" Value="接続済み">
                                        <Setter Property="Background" Value="#DCFCE7"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionStatus}" Value="接続中...">
                                        <Setter Property="Background" Value="#FEF9C3"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionStatus}" Value="再接続中...">
                                        <Setter Property="Background" Value="#FEF9C3"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionStatus}" Value="切断">
                                        <Setter Property="Background" Value="#FEE2E2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ConnectionStatus}" FontSize="13"
                                   FontWeight="SemiBold" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#374151"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConnectionStatus}" Value="接続済み">
                                            <Setter Property="Foreground" Value="#15803D"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConnectionStatus}" Value="切断">
                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- ビジーインジケーター -->
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,12"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

                    <!-- 接続ボタン -->
                    <Button Content="接続する" Margin="0,0,0,8"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ConnectCommand}"/>

                    <!-- 切断ボタン -->
                    <Button Content="切断する" Margin="0,0,0,8"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Stretch"
                            Command="{Binding DisconnectCommand}"/>

                    <Separator Margin="0,8"/>

                    <!-- 再接続ボタン（常時表示、無効時はグレー） -->
                    <Button Content="再接続" Margin="0,0,0,4"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ReconnectCommand}"/>

                    <TextBlock Text="切断後に手動で再接続します"
                               FontSize="11" Foreground="#9CA3AF"
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>

                </StackPanel>
            </Border>
        </Grid>
            </TabItem>

            <!-- 設定タブ -->
            <TabItem Style="{StaticResource Tab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconSliders}" Width="15" Height="15" Margin="0,0,6,0"/>
                        <TextBlock Text="設定" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <local:ErrorLogView x:Name="SettingsView"
                    xmlns:local="clr-namespace:VMonitor.UI"/>
            </TabItem>

        </TabControl>

        <!-- ━━━ ステータスバー ━━━ -->
        <Border Grid.Row="3" Background="#E5E7EB" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- 状態はヘッダーに集約した。ここは常駐していることと、
                     どの版が動いているかを置く。どちらも他所に出ていない。 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconWifi}"
                          Style="{StaticResource Icon}"
                          Stroke="{StaticResource Faint}"
                          Width="13" Height="13" Margin="0,0,6,0"/>
                    <TextBlock Text="スマホからの接続を待ち受けています"
                               FontSize="11" Foreground="#6B7280"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11"
                           Foreground="#9CA3AF"
                           Text="{Binding DataContext.Update.CurrentVersionText,
                                  ElementName=SettingsView,
                                  StringFormat='バージョン {0}'}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
