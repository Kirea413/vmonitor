<!--
    共通の見た目。

    ボタンや余白を画面ごとに書いていたため、同じ役割のものが
    場所によって違う形をしていた。ここに集めて、どの画面でも
    同じ役割は同じ見た目になるようにする。

    アイコンは絵文字をやめてベクターにした。絵文字は
      ・OS とフォントで形も色も変わる（Windows では絵柄が浮く）
      ・文字扱いなのでベースラインがずれ、縦位置が揃わない
      ・色を指定できず、無効状態でも色が変わらない
    という問題があり、UI の部品としては扱いにくい。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══ 色 ══════════════════════════════════════════════════════════ -->
    <!-- 青はアイコンと揃えて #2563EB。 -->
    <Color x:Key="AccentColor">#2563EB</Color>

    <SolidColorBrush x:Key="Accent"      Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentHover" Color="#1D4FD7"/>
    <SolidColorBrush x:Key="AccentPress" Color="#1A45BE"/>
    <SolidColorBrush x:Key="AccentSoft"  Color="#EFF4FE"/>

    <SolidColorBrush x:Key="Ink"      Color="#10151C"/>
    <SolidColorBrush x:Key="Body"     Color="#374151"/>
    <SolidColorBrush x:Key="Muted"    Color="#6B7280"/>
    <SolidColorBrush x:Key="Faint"    Color="#9CA3AF"/>

    <SolidColorBrush x:Key="Surface"  Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Canvas"   Color="#F3F4F6"/>
    <SolidColorBrush x:Key="Line"     Color="#E2E6EC"/>
    <SolidColorBrush x:Key="LineSoft" Color="#EEF1F5"/>

    <!-- 状態。アクセントとは別に持つ。青は「操作できる」の色なので、
         そこに良し悪しの意味まで載せると読み取れなくなる。 -->
    <SolidColorBrush x:Key="Good"     Color="#16A34A"/>
    <SolidColorBrush x:Key="Warn"     Color="#D97706"/>
    <SolidColorBrush x:Key="Bad"      Color="#DC2626"/>
    <SolidColorBrush x:Key="Idle"     Color="#D1D5DB"/>

    <!-- ══ アイコン（24x24 のパス） ═══════════════════════════════════ -->

    <Geometry x:Key="IconMonitor">
        M3,4 H21 A1,1 0 0 1 22,5 V16 A1,1 0 0 1 21,17 H3 A1,1 0 0 1 2,16 V5 A1,1 0 0 1 3,4 Z
        M9,20 H15 M12,17 V20
    </Geometry>

    <Geometry x:Key="IconPhone">
        M8,2 H16 A2,2 0 0 1 18,4 V20 A2,2 0 0 1 16,22 H8 A2,2 0 0 1 6,20 V4 A2,2 0 0 1 8,2 Z
        M10.5,19 H13.5
    </Geometry>

    <Geometry x:Key="IconUsb">
        M12,22 V6 M12,6 L9,9.5 M12,6 L15,9.5
        M12,14 L7,11 V8 M12,12 L17,9 V6.5
        M6,7.5 A1.2,1.2 0 1 1 8.4,7.5 A1.2,1.2 0 1 1 6,7.5 Z
        M15.8,5.2 H18.2 V7.6 H15.8 Z
    </Geometry>

    <Geometry x:Key="IconWifi">
        M2.5,8.5 A14,14 0 0 1 21.5,8.5
        M6,12.2 A9,9 0 0 1 18,12.2
        M9.4,15.8 A4.2,4.2 0 0 1 14.6,15.8
        M12,19.5 A0.8,0.8 0 1 1 12,19.51 Z
    </Geometry>

    <Geometry x:Key="IconGear">
        M12,15.2 A3.2,3.2 0 1 1 12,8.8 A3.2,3.2 0 1 1 12,15.2 Z
        M19.4,15 A1.6,1.6 0 0 0 19.7,16.8 L19.8,16.9 A2,2 0 1 1 17,19.7 L16.9,19.6
        A1.6,1.6 0 0 0 15.1,19.3 A1.6,1.6 0 0 0 14.1,20.8 V21 A2,2 0 1 1 10.1,21 V20.9
        A1.6,1.6 0 0 0 9,19.4 A1.6,1.6 0 0 0 7.2,19.7 L7.1,19.8 A2,2 0 1 1 4.3,17 L4.4,16.9
        A1.6,1.6 0 0 0 4.7,15.1 A1.6,1.6 0 0 0 3.2,14.1 H3 A2,2 0 1 1 3,10.1 H3.1
        A1.6,1.6 0 0 0 4.6,9 A1.6,1.6 0 0 0 4.3,7.2 L4.2,7.1 A2,2 0 1 1 7,4.3 L7.1,4.4
        A1.6,1.6 0 0 0 8.9,4.7 H9 A1.6,1.6 0 0 0 10,3.2 V3 A2,2 0 1 1 14,3 V3.1
        A1.6,1.6 0 0 0 15,4.6 A1.6,1.6 0 0 0 16.8,4.3 L16.9,4.2 A2,2 0 1 1 19.7,7 L19.6,7.1
        A1.6,1.6 0 0 0 19.3,8.9 V9 A1.6,1.6 0 0 0 20.8,10 H21 A2,2 0 1 1 21,14 H20.9
        A1.6,1.6 0 0 0 19.4,15 Z
    </Geometry>

    <!--
        設定。歯車は歯が細かく、14px 前後では必ず団子になる。
        つまみ付きの横線なら小さくても形が残るので、こちらを使う。
    -->
    <Geometry x:Key="IconSliders">
        M4,7 H20 M4,12 H20 M4,17 H20
        M9,7 A1.9,1.9 0 1 1 9,6.99 Z
        M15,12 A1.9,1.9 0 1 1 15,11.99 Z
        M8,17 A1.9,1.9 0 1 1 8,16.99 Z
    </Geometry>

    <Geometry x:Key="IconSearch">
        M11,18 A7,7 0 1 1 11,4 A7,7 0 1 1 11,18 Z M20,20 L16,16
    </Geometry>

    <Geometry x:Key="IconWarning">
        M12,3 L22,20 H2 Z M12,9 V14 M12,17 V17.01
    </Geometry>

    <Geometry x:Key="IconLink">
        M9.5,14.5 L14.5,9.5
        M11,6.5 L13,4.5 A3.5,3.5 0 0 1 19.5,11 L17.5,13
        M13,17.5 L11,19.5 A3.5,3.5 0 0 1 4.5,13 L6.5,11
    </Geometry>

    <!-- ══ アイコン表示 ════════════════════════════════════════════════
         線画で統一する。塗りのアイコンと混ぜると、同じ大きさでも
         重さが揃わない。太さは 1.8 に固定。 -->
    <Style x:Key="Icon" TargetType="Path">
        <Setter Property="Stroke" Value="{StaticResource Body}"/>
        <Setter Property="StrokeThickness" Value="1.8"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Fill" Value="Transparent"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="IconAccent" TargetType="Path" BasedOn="{StaticResource Icon}">
        <Setter Property="Stroke" Value="{StaticResource Accent}"/>
    </Style>

    <Style x:Key="IconMuted" TargetType="Path" BasedOn="{StaticResource Icon}">
        <Setter Property="Stroke" Value="{StaticResource Faint}"/>
    </Style>

    <Style x:Key="IconLarge" TargetType="Path" BasedOn="{StaticResource Icon}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="StrokeThickness" Value="1.4"/>
        <Setter Property="Stroke" Value="{StaticResource Idle}"/>
    </Style>

    <!-- ══ ボタン ══════════════════════════════════════════════════════
         役割ごとに 3 つ。見た目の強さがそのまま「押していい度合い」を
         表すようにする。同じ画面に主要ボタンを 2 つ置かないこと。 -->

    <Style x:Key="ButtonBase" TargetType="Button">
        <Setter Property="MinWidth" Value="88"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="Content"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- キーボードで辿れることが分かるようにする -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{StaticResource Accent}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- いちばん進めたい操作。1 画面に 1 つ。 -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentHover}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentPress}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentPress}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 並び立つ操作。枠だけ。 -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource Body}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#E4EDFD"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 補助。枠も背景も無い。 -->
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource LineSoft}"/>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 取り返しのつかない操作。押す前に気づけるようにする。 -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource Bad}"/>
        <Setter Property="BorderBrush" Value="#F3C6C6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FEF2F2"/>
                <Setter Property="BorderBrush" Value="{StaticResource Bad}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══ 入力欄 ══════════════════════════════════════════════════════
         既定の TextBox は枠が細く、フォーカスがどこにあるか分かりにくい。
         触れる場所であることが見て取れる高さと、押さえた枠にする。 -->

    <Style x:Key="TextField" TargetType="TextBox">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{StaticResource Surface}"
                            BorderBrush="{StaticResource Line}"
                            BorderThickness="1"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- 空のときの案内。別に TextBlock を重ねるより、
                                 ここに置くほうが位置がずれない。 -->
                            <TextBlock x:Name="Placeholder"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="{StaticResource Faint}"
                                       FontSize="13"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          BorderThickness="0"
                                          Background="Transparent"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#C6CEDA"/>
                        </Trigger>
                        <!-- フォーカスは枠を太くして色を変える。
                             細い色替えだけだと、拡大率の低い画面で見えない。 -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{StaticResource Accent}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="Bd" Property="Margin" Value="-1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource LineSoft}"/>
                            <Setter Property="Foreground" Value="{StaticResource Faint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 数字を入れる欄。桁が揃うと読み違えにくい。 -->
    <Style x:Key="NumberField" TargetType="TextBox" BasedOn="{StaticResource TextField}">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Padding" Value="6,6"/>
    </Style>

    <!-- アドレスを入れる欄。等幅にして読み合わせしやすくする。 -->
    <Style x:Key="AddressField" TargetType="TextBox" BasedOn="{StaticResource TextField}">
        <Setter Property="FontFamily" Value="Consolas"/>
    </Style>

    <!-- ══ チェックボックス ════════════════════════════════════════════
         既定のものは四角が小さく、押せる範囲も狭い。 -->
    <Style x:Key="Check" TargetType="CheckBox">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Body}"/>
        <Setter Property="Padding" Value="8,0,0,0"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- ══ タブ ════════════════════════════════════════════════════════
         既定の TabItem は箱が浮き出た古い見た目で、選択中がどれか
         分かりにくい。下線で示す形にして、選択中だけ色を持たせる。 -->

    <Style x:Key="TabStrip" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 見出しの並びと、その下を通す一本の線。
                             線があると、タブと中身が地続きだと分かる。 -->
                        <Border Grid.Row="0" BorderBrush="{StaticResource Line}"
                                BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" Panel.ZIndex="1"
                                      Margin="0,0,0,-1" KeyboardNavigation.TabIndex="1"/>
                        </Border>

                        <ContentPresenter Grid.Row="1"
                                          ContentSource="SelectedContent"
                                          Margin="0,14,0,0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Tab" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,2"
                            Padding="16,9"
                            Margin="0,0,4,0"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="Head"
                                          ContentSource="Header"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource LineSoft}"/>
                            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                        </Trigger>
                        <!-- 選択中は下線と文字色の両方で示す。
                             色だけだと、色の見分けが付きにくい人に伝わらない。 -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{StaticResource Accent}"/>
                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource AccentSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ 面 ══════════════════════════════════════════════════════════ -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- 状態を表す丸。文言を読まなくても分かるようにするためのもの。 -->
    <Style x:Key="StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="9"/>
        <Setter Property="Height" Value="9"/>
        <Setter Property="Fill" Value="{StaticResource Idle}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ══ 既定を差し替える ════════════════════════════════════════════
         ここから下は x:Key を付けない。付けないと、その型のすべてに
         自動で当たる。個別に指定し忘れた場所が Windows 既定の見た目のまま
         取り残されるのを防ぐ。役割を選びたいところだけ x:Key 付きを使う。 -->

    <!-- 何も指定しないボタンは「並び立つ操作」に倒す。
         主役は 1 画面に 1 つなので、既定を主役にしてはいけない。 -->
    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"/>
    <Style TargetType="TextBox" BasedOn="{StaticResource TextField}"/>

    <!-- ── チェックボックス ──
         既定は四角が 13px と小さく、押せる範囲も狭い。 -->
    <Style TargetType="CheckBox">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Body}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- 文字まで含めて押せるようにする。四角だけだと狙いにくい。 -->
                    <Border Background="Transparent" Padding="0,3">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="18" Height="18"
                                    CornerRadius="4"
                                    Background="{StaticResource Surface}"
                                    BorderBrush="{StaticResource Line}"
                                    BorderThickness="1.5"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True">
                                <Path x:Name="Tick"
                                      Data="M4,9.5 L7.5,13 L14,5.5"
                                      Stroke="White" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed"/>
                            </Border>

                            <ContentPresenter Margin="9,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background"
                                    Value="{StaticResource Accent}"/>
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{StaticResource Accent}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{StaticResource Accent}"/>
                            <Setter TargetName="Box" Property="BorderThickness" Value="2.5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── スライダー ──
         既定のつまみは小さく、どこまで進んでいるかも分からない。
         通過した側に色を付けて、量が見えるようにする。 -->
    <Style TargetType="Slider">
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Background="Transparent">
                        <Border Height="4" CornerRadius="2"
                                Background="{StaticResource Line}"
                                VerticalAlignment="Center"/>

                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2"
                                                    Background="{StaticResource Accent}"
                                                    VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>

                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>

                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <!-- 見た目より広い当たり判定。
                                                     18px の丸を正確に掴むのは難しい。 -->
                                                <Border Width="30" Height="24"
                                                        Background="Transparent"/>
                                                <Ellipse x:Name="Knob"
                                                         Width="18" Height="18"
                                                         Fill="{StaticResource Surface}"
                                                         Stroke="{StaticResource Accent}"
                                                         StrokeThickness="2.5"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Knob" Property="Fill"
                                                            Value="{StaticResource AccentSoft}"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Knob" Property="Width" Value="21"/>
                                                    <Setter TargetName="Knob" Property="Height" Value="21"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── スクロールバー ──
         既定は矢印ボタン付きで太く、内容より目立つ。細くして脇に退かせる。 -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                              Opacity="0" Background="Transparent"/>
                            </Track.DecreaseRepeatButton>

                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                              Opacity="0" Background="Transparent"/>
                            </Track.IncreaseRepeatButton>

                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Bar" Width="6"
                                                    CornerRadius="3"
                                                    Background="#C6CEDA"
                                                    Margin="2,0"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bar" Property="Background"
                                                            Value="{StaticResource Muted}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="10"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══ 文字 ════════════════════════════════════════════════════════ -->

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- 区分を表す小さな札。文字だけより早く読める。 -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource LineSoft}"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Body}"/>
    </Style>

</ResourceDictionary>
